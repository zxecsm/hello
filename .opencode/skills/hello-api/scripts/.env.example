# 复制为 .env（与本文件同目录），填写后即可使用。
# .env 已被 .gitignore 忽略，不会提交，也不会被智能体读取。

# hello 远程地址；本地实例可写 http://localhost:55555
HELLO_BASE_URL=https://hello.example.com

# 推荐在页面生成：账号管理 → 生成认证token → 输入有效期天数（1-3650），
# 弹窗会显示 token 并自动全选，点击「复制」后粘贴到下面。
# 也可以用接口生成，在 Hello 页面打开浏览器控制台执行：
# fetch('/api/user/create-token',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({days:30})}).then(r=>r.json()).then(r=>console.log(r.data))
# 必须包含 token= 前缀。也可以直接粘贴浏览器开发者工具里的 Cookie（有效期约 2 天）。
HELLO_COOKIE=token=页面生成的token

# 如果 Cookie 放在单独文件里，改用下面这行（HELLO_COOKIE 留空）
# HELLO_COOKIE_FILE=C:\Users\you\cookie.txt

# 仅在必须使用账号密码登录时才填写
# HELLO_USERNAME=admin
# HELLO_PASSWORD=
