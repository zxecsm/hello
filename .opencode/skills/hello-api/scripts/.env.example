# 复制为 .env（与本文件同目录），填写后即可使用。
# .env 已被 .gitignore 忽略，不会提交，也不会被智能体读取。

# hello 远程地址；本地实例可写 http://localhost:55555
HELLO_BASE_URL=https://hello.example.com

# 浏览器开发者工具里复制的 Cookie，必须包含 token=...
# 可以直接粘贴整行 "Cookie: token=..."，CLI 会自动去掉前缀
HELLO_COOKIE=token=在这里粘贴浏览器 Cookie

# 如果 Cookie 放在单独文件里，改用下面这行（HELLO_COOKIE 留空）
# HELLO_COOKIE_FILE=C:\Users\you\cookie.txt

# 仅在必须使用账号密码登录时才填写
# HELLO_USERNAME=admin
# HELLO_PASSWORD=
